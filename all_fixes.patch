+    section("Summary")
+    total = len(era5_df) + len(metar_df) + len(nwp_df)
+    print(f"  ERA5   : {len(era5_df):>10,} rows")
+    print(f"  METAR  : {len(metar_df):>10,} rows")
+    print(f"  NWP    : {len(nwp_df):>10,} rows")
+    print(f"  Total  : {total:>10,} rows")
+    print()
+
+
+if __name__ == "__main__":
